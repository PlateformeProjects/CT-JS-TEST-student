{
  "name": "ct-js-test",
  "version": "1.0.0",
  "description": "Exercices sur la resolution de tests unitaires, d'integration et E2E en JavaScript",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "start-server-and-test dev http://localhost:5173 'cypress run'",
    "test:e2e:open": "start-server-and-test dev http://localhost:5173 'cypress open'"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "babel-jest": "^29.6.1",
    "cypress": "^12.17.2",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^29.6.1",
    "start-server-and-test": "^2.0.0",
    "vite": "^4.4.5"
  }
}
